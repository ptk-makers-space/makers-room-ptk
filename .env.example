# --- Corporate proxy (only needed if direct internet access is blocked) ---
# If `npm run dev` logs "fetch failed" when calling Supabase/Resend/etc,
# set this to your proxy so the server's outbound fetch calls can reach them.
# HTTPS_PROXY=http://proxy.example.com:8080

# --- Supabase -------------------------------------------------------------
# Project settings -> Data API, and Project settings -> API keys.

# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses row level security - never expose this to the browser
# and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Print reminder emails -------------------------------------------------
# Vercel sends this value as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=generate-a-long-random-value
RESEND_API_KEY=re_your-api-key
PRINT_REMINDER_FROM=MakersRoom <prints@your-verified-domain.example>
PRINT_REMINDER_TIME_ZONE=Asia/Jerusalem
